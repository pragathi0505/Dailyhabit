rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserSettings(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() <= 80 &&
             data.targetExerciseMinutes is int && data.targetExerciseMinutes >= 10 && data.targetExerciseMinutes <= 240 &&
             data.targetMorningStudyMinutes is int && data.targetMorningStudyMinutes >= 10 && data.targetMorningStudyMinutes <= 240 &&
             data.targetEveningStudyMinutes is int && data.targetEveningStudyMinutes >= 10 && data.targetEveningStudyMinutes <= 240 &&
             data.targetSleepHours is number && data.targetSleepHours >= 4 && data.targetSleepHours <= 12 &&
             data.targetBedtimeMinutes is int && data.targetBedtimeMinutes >= 0 && data.targetBedtimeMinutes <= 1439 &&
             data.targetWakeTimeMinutes is int && data.targetWakeTimeMinutes >= 0 && data.targetWakeTimeMinutes <= 1439 &&
             data.targetWaterGlasses is int && data.targetWaterGlasses >= 1 && data.targetWaterGlasses <= 20 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyLog(data, userId, dateKey) {
      return data.userId is string && data.userId == userId &&
             data.dateKey is string && data.dateKey == dateKey && isValidDateKey(data.dateKey) &&
             data.exerciseMinutes is int && data.exerciseMinutes >= 0 && data.exerciseMinutes <= 600 &&
             data.morningStudyMinutes is int && data.morningStudyMinutes >= 0 && data.morningStudyMinutes <= 600 &&
             data.eveningStudyMinutes is int && data.eveningStudyMinutes >= 0 && data.eveningStudyMinutes <= 600 &&
             data.sleepHours is number && data.sleepHours >= 0 && data.sleepHours <= 24 &&
             data.bedtimeMinutes is int && data.bedtimeMinutes >= 0 && data.bedtimeMinutes <= 1439 &&
             data.wakeTimeMinutes is int && data.wakeTimeMinutes >= 0 && data.wakeTimeMinutes <= 1439 &&
             data.sleepQuality is int && data.sleepQuality >= 0 && data.sleepQuality <= 5 &&
             data.screenFreeWindDown is bool &&
             data.waterGlasses is int && data.waterGlasses >= 0 && data.waterGlasses <= 30 &&
             data.mindfulMealsCount is int && data.mindfulMealsCount >= 0 && data.mindfulMealsCount <= 20 &&
             data.totalMealsCount is int && data.totalMealsCount >= 0 && data.totalMealsCount <= 20 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFocusSession(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidDateKey(data.dateKey) &&
             data.category is string && data.category in ['EXERCISE', 'MORNING_APPSC', 'EVENING_APPSC'] &&
             data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120 &&
             data.paperTag is string && data.paperTag.size() <= 60 &&
             data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 360 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMealEntry(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidDateKey(data.dateKey) &&
             data.mealType is string && data.mealType in ['BREAKFAST', 'LUNCH', 'DINNER', 'SNACK'] &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 160 &&
             data.distractionFree is bool &&
             data.slowPace is bool &&
             data.satisfiedStop is bool &&
             data.nutritionQuality is string && data.nutritionQuality in ['BALANCED', 'LIGHT', 'INDULGENT'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyReminder(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.message is string && data.message.size() <= 200 &&
             data.category is string && data.category in ['EXERCISE', 'MORNING_APPSC', 'EVENING_APPSC', 'SLEEP', 'MINDFUL_EATING'] &&
             data.hour is int && data.hour >= 0 && data.hour <= 23 &&
             data.minute is int && data.minute >= 0 && data.minute <= 59 &&
             data.enabled is bool &&
             data.daysOfWeek is list && data.daysOfWeek.size() <= 7 &&
             (data.daysOfWeek.size() == 0 || data.daysOfWeek[0] is int) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // User profile & daily targets
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'targetExerciseMinutes',
                         'targetMorningStudyMinutes', 'targetEveningStudyMinutes',
                         'targetSleepHours', 'targetBedtimeMinutes', 'targetWakeTimeMinutes',
                         'targetWaterGlasses', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'targetExerciseMinutes',
                         'targetMorningStudyMinutes', 'targetEveningStudyMinutes',
                         'targetSleepHours', 'targetBedtimeMinutes', 'targetWakeTimeMinutes',
                         'targetWaterGlasses', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserSettings(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserSettings(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'targetExerciseMinutes',
                         'targetMorningStudyMinutes', 'targetEveningStudyMinutes',
                         'targetSleepHours', 'targetBedtimeMinutes', 'targetWakeTimeMinutes',
                         'targetWaterGlasses', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Daily summary logs keyed by yyyy-MM-dd
      match /dailyLogs/{dateKey} {
        allow get: if isOwner(userId) && isValidDateKey(dateKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'exerciseMinutes', 'morningStudyMinutes',
                           'eveningStudyMinutes', 'sleepHours', 'bedtimeMinutes',
                           'wakeTimeMinutes', 'sleepQuality', 'screenFreeWindDown',
                           'waterGlasses', 'mindfulMealsCount', 'totalMealsCount',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'exerciseMinutes', 'morningStudyMinutes',
                           'eveningStudyMinutes', 'sleepHours', 'bedtimeMinutes',
                           'wakeTimeMinutes', 'sleepQuality', 'screenFreeWindDown',
                           'waterGlasses', 'mindfulMealsCount', 'totalMealsCount',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidDailyLog(incoming(), userId, dateKey);

        allow update: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         isValidDailyLog(incoming(), userId, dateKey) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'exerciseMinutes', 'morningStudyMinutes',
                           'eveningStudyMinutes', 'sleepHours', 'bedtimeMinutes',
                           'wakeTimeMinutes', 'sleepQuality', 'screenFreeWindDown',
                           'waterGlasses', 'mindfulMealsCount', 'totalMealsCount',
                           'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidDateKey(dateKey);
      }

      // Exercise and APPSC Group 1 focus sessions
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'category', 'topic',
                           'paperTag', 'durationMinutes', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'category', 'topic',
                           'paperTag', 'durationMinutes', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidFocusSession(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         isValidFocusSession(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'dateKey', 'category', 'topic',
                           'paperTag', 'durationMinutes', 'notes', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      // Mindful eating meal logs
      match /meals/{mealId} {
        allow get: if isOwner(userId) && isValidId(mealId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(mealId) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'mealType', 'description',
                           'distractionFree', 'slowPace', 'satisfiedStop',
                           'nutritionQuality', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'mealType', 'description',
                           'distractionFree', 'slowPace', 'satisfiedStop',
                           'nutritionQuality', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMealEntry(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(mealId) &&
                         isValidMealEntry(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'dateKey', 'mealType', 'description',
                           'distractionFree', 'slowPace', 'satisfiedStop',
                           'nutritionQuality', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(mealId);
      }

      // Customizable daily reminders
      match /reminders/{reminderId} {
        allow get: if isOwner(userId) && isValidId(reminderId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'message', 'category',
                           'hour', 'minute', 'enabled', 'daysOfWeek',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'message', 'category',
                           'hour', 'minute', 'enabled', 'daysOfWeek',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidDailyReminder(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         isValidDailyReminder(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'message', 'category',
                           'hour', 'minute', 'enabled', 'daysOfWeek',
                           'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(reminderId);
      }
    }
  }
}
